[Unit]
Description=Infotherapy Flask Application
After=network.target

[Service]
Type=notify
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/infotherapy
Environment=PATH=/home/ubuntu/infotherapy/venv/bin
ExecStart=/home/ubuntu/infotherapy/venv/bin/gunicorn --config gunicorn.conf.py application:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
